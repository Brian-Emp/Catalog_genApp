# Example environment for catalog-gen-app.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`
# (it is gitignored). All variables below are OPTIONAL — the app runs with
# sane defaults and the AI features disable themselves when no key is present.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
# In `production`, error responses are collapsed to generic messages (no
# internal paths / stack traces / orchestrator errors leak to the client).
NODE_ENV=production
# HMAC secret used to sign generated-PDF download URLs. If unset, a random
# secret is generated at boot (links then break across restarts — set a fixed
# value in production).
DOWNLOAD_SECRET=<random-hex-string>
# Optional TTL (ms) for download URLs. 0/unset = no expiry (history links stay
# valid). Set e.g. 86400000 (24h) to make signed URLs expire.
DOWNLOAD_TTL_MS=0

# ── Auth (optional, OFF by default = trusted local network) ──────────────────
# Shared token guarding the mutating / costly endpoints:
#   DELETE /api/history, GET /api/gemini/smoke, ?reset=1 on stats/circuit.
# When UNSET the app stays open (single-user local use). Set it when the server
# is exposed; clients then send `X-Auth-Token: <token>` or
# `Authorization: Bearer <token>`. APP_AUTH_TOKEN is an accepted alias.
ADMIN_TOKEN=

# ── Rate limiting (optional, per-IP, sane defaults) ──────────────────────────
# Trust X-Forwarded-For ONLY behind a known reverse proxy. Leave UNSET when the
# app is directly exposed: req.ip then uses the real socket address, which a
# client cannot spoof (otherwise the per-IP rate limits are trivially bypassed).
# Behind a proxy, set to the hop count ("1") or the proxy IP/CIDR.
TRUST_PROXY=
# Broad /api ceiling per minute (health probe + progress polling are exempt).
RATE_MAX_API=200
# Strict ceiling for the costly POST /api/generate, per minute.
RATE_MAX_GENERATE=5
# Very strict ceiling for GET /api/gemini/smoke (real Gemini calls), per 5 min.
RATE_MAX_SMOKE=3
# Very strict ceiling for POST /api/layout (Gemini Pro per page), per 5 min.
RATE_MAX_LAYOUT=3

# ── AI credentials (optional) ───────────────────────────────────────────────
# Gemini REST API key (text + vision). Leave empty to disable Gemini features.
GEMINI_API_KEY=
# Alternatively, point to a file containing the key (used by the Docker setup).
GEMINI_KEY_FILE=
# Override binary locations if not on PATH.
CLAUDE_BIN=claude
GEMINI_BIN=gemini
CATGEN_BIN=

# ── Upload / parsing limits (optional, defaults are conservative) ────────────
MAX_CSV_BYTES=
MAX_CSV_ROWS=
MAX_XLSX_BYTES=
MAX_ZIP_ENTRIES=
MAX_ZIP_UNCOMPRESSED_BYTES=
MAX_ZIP_COMPRESSION_RATIO=

# ── Tests / debug (optional) ────────────────────────────────────────────────
# Set to 0 to run the live Claude-CLI skill test (needs claude auth).
SKIP_CLAUDE_LIVE=1
# Base URL for the smoke test.
SMOKE_URL=http://localhost:8080
# Verbose pipeline debugging.
DEBUG_BLOCKS=
DEBUG_SUBSTITUTOR=
REFLOW_SPECS=
