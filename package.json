{
  "name": "catalog-gen-app",
  "version": "0.2.0",
  "private": true,
  "description": "Substitution de catalogues PDF : reprend un catalogue existant et y injecte de nouveaux produits",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash tests/smoke.sh",
    "fixtures:synth": "node scripts/buildSyntheticFixtures.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "adm-zip": "^0.5.14",
    "csv-parse": "^5.5.6",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "helmet": "^8.2.0",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/adm-zip": "^0.5.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.5"
  }
}
